{
  "name": "c0de-agent",
  "version": "0.1.0",
  "description": "Open-source AI coding assistant with Browser-Server architecture",
  "type": "module",
  "bin": {
    "c0de": "./dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p src/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build:web": "vite build --config src/web/vite.config.ts",
    "preview:web": "vite preview --config src/web/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@linaria/vite": "^5.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^15.11.7",
    "pg": "^8.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hono/node-server": "^2.0.6",
    "@linaria/core": "^5.0.2",
    "@linaria/react": "^5.0.3",
    "@native-router/core": "^1.1.0",
    "@native-router/react": "^1.1.2",
    "@tanstack/react-query": "^5.101.1",
    "drizzle-orm": "^0.45.2",
    "haze-ui": "^1.6.0",
    "hono": "^4.12.27",
    "marked": "^12.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^1.29.2"
  }
}
