{
  "name": "c0de-agent",
  "version": "0.1.0",
  "description": "Open-source AI coding assistant with Browser-Server architecture",
  "type": "module",
  "bin": {
    "c0de": "./dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p src/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "author": "wmzy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/c0de-agent.git"
  },
  "bugs": {
    "url": "https://github.com/wmzy/c0de-agent/issues"
  },
  "homepage": "https://github.com/wmzy/c0de-agent#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@wyw-in-js/vite": "^2.5.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.14.0",
    "node-gyp": "^13.0.2",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@native-router/core": "^1.15.1",
    "@native-router/react": "^1.14.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fuzzysort": "^4.0.2",
    "haze-ui": "^1.21.0",
    "hono": "^4.13.5",
    "lucide-react": "^1.40.0",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "shiki": "^4.4.3",
    "trash": "^10.1.1",
    "undici": "^8.10.1",
    "ws": "^8.21.3"
  }
}
